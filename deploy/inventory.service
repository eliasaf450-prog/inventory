[Unit]
Description=Clothing Inventory (Node.js)
After=network.target

[Service]
Type=simple
# המשתמש והנתיב נקבעים אוטומטית ע"י setup.sh
User=inventory
WorkingDirectory=/opt/inventory
ExecStart=/usr/bin/node --no-warnings server.js
Restart=always
RestartSec=3
# האפליקציה מקשיבה רק על לוקאל-הוסט; Caddy חושף אותה החוצה עם HTTPS
Environment=PORT=3000
Environment=HOST=127.0.0.1
# מסד הנתונים נשמר כאן (קובץ SQLite). גבו את התיקייה הזו!
Environment=DB_PATH=/opt/inventory/data/inventory.db

[Install]
WantedBy=multi-user.target
